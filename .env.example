APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=debug

# Supabase Postgres or any PostgreSQL-compatible connection string.
# Persistent backends should prefer a direct connection when IPv6 is available,
# otherwise Supavisor session mode on port 5432.
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s

# Base64-encoded 32-byte AES key used only to encrypt merchant webhook signing secrets.
# Generate with: openssl rand -base64 32
WEBHOOK_SECRET_MASTER_KEY=
WEBHOOK_WORKER_INTERVAL=1s
WEBHOOK_HTTP_TIMEOUT=10s
